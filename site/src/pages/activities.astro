---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { Calendar, ArrowRight } from 'lucide-react';
import { EN } from '../i18n/content';

const activities = (await getCollection('activities')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const news = (await getCollection('news')).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const enActivities = EN.activities as Record<string, { title: string; description: string }>;
const enNews = EN.news as Record<string, { title: string; summary: string }>;
---

<Layout title="项目进展" titleEn="Progress">
  <div class="max-w-7xl mx-auto px-4 py-12 sm:py-20">
    <div class="mb-16">
      <h1 class="text-4xl font-bold text-gray-900 mb-4" data-i18n-key="activities.title">Team Activities</h1>
      <p class="text-lg text-gray-600" data-i18n-key="activities.subtitle">
        Workshops, seminars, and team building events.
      </p>
    </div>

    <!-- Activities Gallery -->
    <h2 class="text-2xl font-bold text-gray-900 mb-8"><span data-lang="zh">项目动态</span><span data-lang="en">{EN.pages.activitiesUpdates}</span></h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-20">
      {activities.map(activity => (
        <a href={`/activities/${activity.id.replace(/\.[^/.]+$/, "")}`} class="group bg-white border border-gray-100 rounded-2xl overflow-hidden hover:shadow-lg transition-all block">
          {activity.data.cover && (
            <div class="h-56 overflow-hidden bg-gray-100 relative">
               <Image 
                src={activity.data.cover} 
                alt={activity.data.title} 
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                quality={80}
                format="webp"
                width={600}
              />
                 <div class="flex items-center text-white/90 text-sm absolute bottom-4 left-4 bg-black/30 px-3 py-1 rounded-full backdrop-blur-sm">
                    <Calendar className="w-4 h-4 mr-2" />
                    <time>{activity.data.date.toISOString().split('T')[0]}</time>
                 </div>
            </div>
          )}
          <div class="p-6">
            <h3 class="text-lg font-bold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">
              <span data-lang="zh">{activity.data.title}</span>
              <span data-lang="en">{enActivities[activity.id.replace(/\.[^/.]+$/, '')]?.title}</span>
            </h3>
            <p class="text-gray-600 text-sm line-clamp-3">
              <span data-lang="zh">{activity.data.description}</span>
              <span data-lang="en">{enActivities[activity.id.replace(/\.[^/.]+$/, '')]?.description}</span>
            </p>
          </div>
        </a>
      ))}
      {activities.length === 0 && (
         <div class="col-span-full text-center py-12 bg-gray-50 rounded-xl">
            <p class="text-gray-500" data-i18n-key="activities.noActivities">No activities added yet.</p>
         </div>
      )}
    </div>

    <!-- News List -->
    <h2 class="text-2xl font-bold text-gray-900 mb-8"><span data-lang="zh">项目节点</span><span data-lang="en">{EN.pages.activitiesMilestones}</span></h2>
    <div class="border-l-2 border-gray-100 pl-8 space-y-12 max-w-3xl">
      {news.map(item => (
        <div class="relative">
          <span class="absolute -left-[37px] top-1.5 w-4 h-4 rounded-full bg-blue-100 border-2 border-white ring-1 ring-blue-600"></span>
          <time class="block text-sm text-gray-500 mb-2">{item.data.date.toISOString().split('T')[0]}</time>
          <h3 class="text-xl font-bold text-gray-900 mb-2">
            <span data-lang="zh">{item.data.title}</span>
            <span data-lang="en">{enNews[item.id.replace(/\.[^/.]+$/, '')]?.title}</span>
          </h3>
          {item.data.summary && (
            <p class="text-gray-600">
              <span data-lang="zh">{item.data.summary}</span>
              <span data-lang="en">{enNews[item.id.replace(/\.[^/.]+$/, '')]?.summary}</span>
            </p>
          )}
        </div>
      ))}
    </div>
  </div>
</Layout>
