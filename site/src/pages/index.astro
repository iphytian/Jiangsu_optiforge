---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { ArrowRight, Calendar } from 'lucide-react';
import { SITE } from '../config';
import { EN } from '../i18n/content';
import { withBase } from '../utils/url';

const activities = (await getCollection('activities'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout title="江苏省前沿技术研发项目" titleEn="Jiangsu Frontier Technology R&D Project" fullTitle={true}>
  <!-- Hero Section -->
  <section class="relative h-screen min-h-[600px] flex items-center justify-center overflow-hidden">
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      {SITE.hero.image ? (
        <Image 
          class="w-full h-full object-cover" 
          src={SITE.hero.image} 
          alt={SITE.hero.title}
          loading="eager"
          fetchpriority="high"
          decoding="sync"
          quality={60}
          format="webp"
          widths={[640, 1024, 1920]}
          sizes="100vw"
        />
      ) : (
        <div class="w-full h-full bg-gradient-to-br from-gray-900 to-gray-800"></div>
      )}
      <!-- Dark Gradient Overlay for Readability -->
      <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/50 to-transparent"></div>
      <!-- Subtle Texture (CSS only) -->
      <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 32px 32px;"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <div class="max-w-4xl">
        <h1 class="text-4xl font-bold text-white sm:text-5xl md:text-6xl mb-6 drop-shadow-lg leading-tight">
          <span data-lang="zh">
            <span class="block">面向航天遥感 · 深空探测</span>
            <span class="block">高能激光 · 大型望远镜</span>
            <span class="block">实现大口径镜面智能制造</span>
          </span>
          <span data-lang="en" class="block text-3xl sm:text-4xl md:text-5xl">
            {EN.hero.lines.map(line => <span class="block">{line}</span>)}
          </span>
        </h1>
        <div class="mt-10 flex gap-4">
          <a href={withBase('/publications')} class="flex items-center justify-center px-8 py-4 border border-transparent text-lg font-medium rounded-full text-black bg-white hover:bg-gray-100 transition-all duration-300 shadow-[0_0_20px_rgba(255,255,255,0.3)] hover:shadow-[0_0_30px_rgba(255,255,255,0.5)]" data-i18n-key="hero.viewPubs">
            查看文章
          </a>
          <a href={withBase('/activities')} class="flex items-center justify-center px-8 py-4 border-2 border-white/30 text-lg font-medium rounded-full text-white hover:bg-white/10 transition-all duration-300 backdrop-blur-sm" data-i18n-key="hero.meetTeam">
            查看进展
          </a>
        </div>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce text-white/50">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </section>

  <!-- Latest Activities -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-8">
        <h2 class="text-3xl font-bold text-gray-900" data-i18n-key="section.latestNews">Latest Activities</h2>
        <a href={withBase('/activities')} class="text-blue-600 hover:text-blue-700 font-medium flex items-center gap-1 group">
          <span data-i18n-key="section.viewAll">View all</span> <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </a>
      </div>

      <div class="grid gap-8 md:grid-cols-3">
        {activities.map(item => {
          const link = withBase(`/activities/${item.id.replace(/\.[^/.]+$/, "")}`);
          return (
          <div class="group bg-white rounded-xl border border-gray-100 overflow-hidden hover:shadow-lg transition-all">
            {item.data.cover && (
              <a href={link} class="block h-48 overflow-hidden">
                <Image 
                  src={item.data.cover} 
                  alt={item.data.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                  quality={80}
                  format="webp"
                  widths={[320, 480, 600]}
                  sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
                />
              </a>
            )}
            <div class="p-6">
              <div class="text-sm text-gray-500 mb-2 flex items-center gap-2">
                 <Calendar className="w-4 h-4" />
                 {item.data.date.toISOString().split('T')[0]}
              </div>
              <h3 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors mb-2 line-clamp-2">
                <a href={link}>
                  <span data-lang="zh">{item.data.title}</span>
                  <span data-lang="en">{EN.activities[item.id.replace(/\.[^/.]+$/, '')]?.title}</span>
                </a>
              </h3>
              <p class="text-gray-600 line-clamp-3 text-sm">
                <span data-lang="zh">{item.data.description || (item.body || '').substring(0, 100)}</span>
                <span data-lang="en">{EN.activities[item.id.replace(/\.[^/.]+$/, '')]?.description}</span>
              </p>
            </div>
          </div>
        )})}
      </div>
    </div>
  </section>
</Layout>
